# SCMS_Delivery 数据库连接配置（复制为 config/.env 后填写，切勿提交到 git）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_USER=root
MYSQL_ROOT_PWD=你的root密码
MYSQL_ETL_USER=scms_etl
MYSQL_ETL_PWD=你的etl密码
MYSQL_BI_USER=scms_bi
MYSQL_BI_PWD=你的bi密码
MYSQL_API_USER=scms_api
MYSQL_API_PWD=你的api密码

# Streamlit 前端连接 FastAPI 的地址
SCMS_API_BASE=http://127.0.0.1:8000
